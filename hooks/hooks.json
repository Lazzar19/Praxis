{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "node \"$CURSOR_PLUGIN_ROOT/hooks/praxis.mjs\" session" }],
    "preToolUse": [
      {
        "command": "node \"$CURSOR_PLUGIN_ROOT/hooks/praxis.mjs\" gate",
        "matcher": "Write|StrReplace|Delete|EditNotebook|Edit|ApplyPatch"
      }
    ],
    "stop": [{ "command": "node \"$CURSOR_PLUGIN_ROOT/hooks/praxis.mjs\" stop" }]
  }
}
