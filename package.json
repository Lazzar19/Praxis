{
  "name": "learn-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "displayName": "Praxis",
  "description": "Teaches in chat before code is written. No setup command.",
  "engines": {
    "node": ">=20",
    "vscode": "^1.95.0"
  },
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.extension.json && esbuild src/extension/extension.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/extension.cjs --external:vscode --sourcemap",
    "start": "node dist/index.js",
    "test": "tsx --test src/*.test.ts src/extension/*.test.ts",
    "demo": "node docs/demo-session.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.145.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
